#!/bin/bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

usage() {
    echo "Usage: remove-kernel <command> [args]"
    echo ""
    echo "Commands:"
    echo "  list                 List all installed kernels"
    echo "  latest               Remove the latest installed kernel"
    echo "  version <version>    Remove a specific kernel version"
    echo ""
    echo "Examples:"
    echo "  remove-kernel list"
    echo "  remove-kernel latest"
    echo "  remove-kernel version 6.19.12-100.fc42.x86_64"
}

get_installed_versions() {
    rpm -qa kernel-core --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort -V
}

get_running_kernel() {
    uname -r
}

remove_kernel_version() {
    local version="$1"
    local running
    running=$(get_running_kernel)

    # Verify this version is actually installed
    if ! get_installed_versions | grep -qF "$version"; then
        echo -e "${RED}Error:${NC} Kernel version '$version' is not installed."
        echo ""
        echo "Installed versions:"
        get_installed_versions | sed 's/^/  /'
        exit 1
    fi

    # Warn if trying to remove the running kernel
    if [[ "$version" == "$running" ]]; then
        echo -e "${RED}WARNING:${NC} You are about to remove the currently running kernel ($running)!"
        echo "This is dangerous. You should reboot into another kernel first."
        read -rp "Are you absolutely sure? (yes/no): " confirm
        if [[ "$confirm" != "yes" ]]; then
            echo "Aborted."
            exit 1
        fi
    fi

    # Check we're not removing the last kernel
    local count
    count=$(get_installed_versions | wc -l)
    if [[ "$count" -le 1 ]]; then
        echo -e "${RED}Error:${NC} This is the only installed kernel. Refusing to remove it."
        exit 1
    fi

    echo -e "Kernel version:  ${YELLOW}${version}${NC}"
    echo -e "Running kernel:  ${GREEN}${running}${NC}"
    echo ""
    echo "The following packages will be removed:"
    rpm -qa "kernel*" | grep "$version" | sort | sed 's/^/  /'
    echo ""

    read -rp "Proceed with removal? (y/N): " confirm
    if [[ "$confirm" != [yY] ]]; then
        echo "Aborted."
        exit 0
    fi

    echo ""
    echo "Removing kernel $version ..."
    sudo dnf remove -y kernel-*-"$version"

    echo ""
    echo -e "${GREEN}Done.${NC} Kernel $version has been removed."
    echo ""
    echo "Remaining kernels:"
    get_installed_versions | sed 's/^/  /'
}

# --- Main ---

if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

case "$1" in
    latest)
        latest_version=$(get_installed_versions | tail -1)
        echo "Latest installed kernel: $latest_version"
        echo ""
        remove_kernel_version "$latest_version"
        ;;
    version)
        if [[ $# -lt 2 ]]; then
            echo -e "${RED}Error:${NC} Please specify a kernel version."
            echo ""
            echo "Installed versions:"
            get_installed_versions | sed 's/^/  /'
            exit 1
        fi
        remove_kernel_version "$2"
        ;;
    list)
        running=$(get_running_kernel)
        echo "Installed kernels:"
        while IFS= read -r ver; do
            if [[ "$ver" == "$running" ]]; then
                echo -e "  ${GREEN}${ver}${NC}  (running)"
            else
                echo "  $ver"
            fi
        done <<< "$(get_installed_versions)"
        ;;
    -h|--help)
        usage
        ;;
    *)
        echo -e "${RED}Error:${NC} Unknown command '$1'"
        echo ""
        usage
        exit 1
        ;;
esac
